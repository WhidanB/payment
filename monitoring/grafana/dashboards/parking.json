      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "clamp_min(sum(increase(parking_operations_total{job=\"$payment_job\",operation=\"payment\",result=\"retried\"}[$__range])) - sum(increase(parking_operations_total{job=\"$payment_job\",operation=\"payment\",result=\"refused\"}[$__range])), 0)",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "description": "Demandes refusées à la 1re tentative puis acceptées au retry automatique (représentées moins refusées définitivement)."
    },
