        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 21,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(parking_operations_total{job=\"$payment_job\",operation=\"payment\",result=\"refused\"}[$__range]))",
          "legendFormat": "",
          "instant": true,
          "range": false
