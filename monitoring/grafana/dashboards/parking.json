      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "description": "POST /payments ayant ouvert une nouvelle demande, sur la période affichée."
    },
