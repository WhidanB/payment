      "description": "Refusées aux deux tentatives : le retry automatique n'a pas suffi."
    },
    {
      "id": 104,
      "type": "stat",
      "title": "Sauvées par la représentation",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
