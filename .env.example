# Copy to .env (git-ignored) for local runs. Never commit real values.

# Neon / PostgreSQL connection string. Leave empty to use in-memory storage.
PAYMENT_DATABASE_URL=

# Shared secret expected in X-API-Key. Leave empty to disable the check locally.
PAYMENT_API_KEY=

PAYMENT_PENDING_DELAY_SECONDS=15
PAYMENT_FAILURE_RATE=0.05
PAYMENT_MAX_ATTEMPTS=2
PAYMENT_LOG_LEVEL=INFO

# Tests only: a disposable database, emptied by the test suite.
# PAYMENT_TEST_DATABASE_URL=
